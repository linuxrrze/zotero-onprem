# ---------------------------------------------------------------------------
# On-premise Zotero -- configuration. Copy to .env; bin/setup.sh fills in every
# empty secret automatically (and never overwrites existing values).
# ---------------------------------------------------------------------------

# Public host names (DNS must resolve them for all clients)
ZOTERO_HOST=zotero.example.org      # API, login page, stream server
S3_HOST=s3.zotero.example.org       # file storage (separate host required)

# S3 object storage backend:
#   garage  -> COMPOSE_PROFILES=garage, S3_BACKEND_PORT=3900
#   rustfs  -> COMPOSE_PROFILES=rustfs, S3_BACKEND_PORT=9000
COMPOSE_PROFILES=garage
S3_BACKEND_PORT=3900

# Use prebuilt images (e.g. from GitHub CI) instead of building locally:
#IMAGE_PREFIX=ghcr.io/<owner>/zotero-onprem
#IMAGE_TAG=latest

# TLS: "internal" (Caddy CA -- distribute caddy root cert to clients),
#      "/certs/fullchain.pem /certs/privkey.pem" (put files into ./certs), or
#      an e-mail address to use ACME.
CADDY_TLS=internal

# Login page
LOGIN_SITE_NAME="Zotero (on-premise)"
LOGIN_AUTH_BACKENDS=local           # any of: local, ldap, oidc  (e.g. oidc,local)

# Optional LDAP / Active Directory (LOGIN_AUTH_BACKENDS must include "ldap")
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_USER_FILTER='(|(uid={login})(mail={login}))'
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
# The directory's certificate is always verified. ldaps:// or ldap:// + StartTLS;
# a private CA goes into ./certs (e.g. LDAP_CA_CERT=/certs/ldap-ca.pem).
LDAP_STARTTLS=0
LDAP_CA_CERT=

# Optional OpenID Connect single sign-on (LOGIN_AUTH_BACKENDS must include "oidc").
# Register a confidential client at the IdP with redirect URI
#   https://<ZOTERO_HOST>/login/oidc/callback
OIDC_ISSUER=                        # e.g. https://idp.uni.example/realms/uni
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid email profile"
OIDC_USERNAME_CLAIM=preferred_username
OIDC_EMAIL_CLAIM=email
# Restrict who may log in (empty = everyone the IdP authenticates), e.g.
#   OIDC_ALLOWED_CLAIM=eduperson_affiliation  OIDC_ALLOWED_VALUES=student,staff,employee,faculty
OIDC_ALLOWED_CLAIM=
OIDC_ALLOWED_VALUES=
OIDC_BUTTON_LABEL="Log in with your university account"

# Default storage quota in MB for every user with a (validated) e-mail address
DEFAULT_STORAGE_QUOTA_MB=10000

# ---- secrets (generated by bin/setup.sh) ----------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_USER=zotero
MYSQL_PASSWORD=
ZOTERO_AUTH_SALT=
ZOTERO_SUPER_USER=zotero-super
ZOTERO_SUPER_PASSWORD=
LOGIN_SECRET_KEY=
# S3 key (Garage needs: id = "GK" + 24 hex chars, secret = 64 hex chars
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
