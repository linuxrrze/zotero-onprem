# MySQL settings for the Zotero dataserver (from dataserver misc/mysql_parameters).
# MySQL 8 is required: the dataserver uses MySQL-8-only SQL (INSERT ... AS new
# ON DUPLICATE KEY UPDATE), so MariaDB will NOT work with current upstream.
[mysqld]
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
# No NO_ZERO_DATE: the schema uses '0000-00-00 00:00:00' defaults
sql_mode = STRICT_ALL_TABLES
log_bin_trust_function_creators = 1
event_scheduler = ON
max_allowed_packet = 134217728
max_connect_errors = 10000
wait_timeout = 1800
skip_name_resolve = 1
innodb_flush_log_at_trx_commit = 1
